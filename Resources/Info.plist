<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MacMediaWidget</string>
    <key>CFBundleDisplayName</key>
    <string>MacMediaWidget</string>
    <key>CFBundleIdentifier</key>
    <string>com.dudivalenza.macmediawidget</string>
    <key>CFBundleExecutable</key>
    <string>MacMediaWidget</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Idioma-base do código é inglês: as chaves de localização são o próprio texto em
         inglês, e pt-BR.lproj traz a tradução. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>pt-BR</string>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>1.16.0</string>
    <key>CFBundleVersion</key>
    <string>16</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- Obrigatório para enviar Apple Events: é o texto que o macOS mostra no prompt
         de permissão de Automação, na primeira vez que o widget fala com um player.
         Sem esta chave o pedido é negado. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>O MacMediaWidget envia comandos ao app de música escolhido para controlar a reprodução, a posição da faixa e o volume do próprio app.</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
