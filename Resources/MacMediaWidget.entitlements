<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Enviar Apple Events para os apps de música (camada AppleScript: posição real,
         seek, volume por-app, shuffle/repeat). Sob hardened runtime, sem esta
         entitlement o Apple Event é bloqueado antes mesmo do prompt de Automação. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- O app roda /usr/bin/perl e /usr/bin/osascript como subprocessos. O hardened
         runtime, por padrão, impede que um processo assinado lance binários que não
         herdam a sua assinatura. Sem isto, o adapter não inicia num build notarizado —
         e o widget fica cego justamente na versão que vai para o cliente. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
